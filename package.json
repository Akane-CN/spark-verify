{
  "name": "ckb-verify",
  "version": "0.0.2",
  "description": "Executable acceptance claims for CKB projects",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "ckb-verify": "./src/cli.ts"
  },
  "files": [
    "src",
    "schemas",
    "patches",
    "docs/install.md",
    "docs/offline-verification.md",
    "docs/evidence-report.md",
    "docs/annotated-manifest.md",
    "docs/cell-claims-draft.4.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "bun test",
    "showcase:secp-transfer": "bash showcases/secp-transfer/verify.sh",
    "showcase:cell-properties": "bash showcases/cell-properties/verify.sh",
    "showcase:ckb-ugmp": "bash showcases/ckb-ugmp/verify.sh",
    "test:devnet": "bun run showcase:secp-transfer",
    "check:supply-chain": "bun run scripts/check-supply-chain.ts",
    "typecheck": "tsc --noEmit",
    "check:bun": "bun run scripts/check-bun-version.ts",
    "check": "bun run check:bun && bun test && bun run typecheck && bun run check:supply-chain && git diff --check"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/bun": "1.2.19",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2.19"
  },
  "packageManager": "bun@1.2.19",
  "dependencies": {
    "@ckb-ccc/core": "1.14.0",
    "ajv": "8.20.0",
    "@ckb-ccc/spore": "1.5.17",
    "@offckb/cli": "0.4.13",
    "adm-zip": "0.6.1",
    "follow-redirects": "1.16.1",
    "json-canonicalize": "3.0.0",
    "tar": "7.5.22"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.1",
    "tar": "7.5.22"
  },
  "patchedDependencies": {
    "@offckb/cli@0.4.13": "patches/@offckb%2Fcli@0.4.13.patch"
  }
}
