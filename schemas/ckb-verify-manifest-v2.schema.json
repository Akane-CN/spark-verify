{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/Akane-CN/spark-verify/schemas/ckb-verify-manifest-v2.schema.json",
 "title": "CKB Verify manifest, spec 0.2.0 (parsed verify.toml)",
 "description": "Shape of a parsed spec 0.2.0 verify.toml. The strict parser additionally enforces cross-field rules (known setup names, pure-step targets, account bounds, the deployer account, at least one claim).",
 "$comment": "Separate from manifest-v1 so the frozen 0.1.0 parts stay byte-for-byte unchanged.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "meta",
  "toolchain",
  "replay",
  "setup"
 ],
 "properties": {
  "meta": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "spec"
   ],
   "properties": {
    "name": {
     "type": "string",
     "pattern": "\\S",
     "maxLength": 100
    },
    "spec": {
     "const": "0.2.0"
    },
    "description": {
     "type": "string",
     "pattern": "\\S"
    }
   }
  },
  "toolchain": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "ckb",
    "offckb"
   ],
   "properties": {
    "ckb": {
     "type": "string",
     "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "offckb": {
     "const": "0.4.13"
    },
    "ckb-debugger": {
     "const": "1.1.1",
     "$comment": "the only pinned debugger artifact (Linux x64)"
    }
   }
  },
  "replay": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "dependencies"
   ],
   "properties": {
    "dependencies": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "enum": [
       "external_time",
       "randomness",
       "fee_estimation",
       "dynamic_since",
       "external_network"
      ]
     }
    }
   }
  },
  "setup": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "accounts"
   ],
   "properties": {
    "accounts": {
     "type": "integer",
     "minimum": 0,
     "maximum": 20
    },
    "scripts": {
     "type": "object",
     "maxProperties": 16,
     "propertyNames": {
      "pattern": "^[a-z_][a-z0-9_]{0,63}$"
     },
     "additionalProperties": {
      "oneOf": [
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "binary",
         "hash_type"
        ],
        "properties": {
         "binary": {
          "type": "string",
          "pattern": "^(?![/\\\\])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\\\u0000-\\u001f]{1,1024}$"
         },
         "hash_type": {
          "enum": [
           "type",
           "data",
           "data1",
           "data2"
          ]
         }
        }
       },
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "builtin"
        ],
        "properties": {
         "builtin": {
          "$ref": "https://spark-verify.invalid/schemas/ckb-verify-claims-v4.schema.json#/$defs/systemScript"
         }
        }
       }
      ]
     }
    }
   }
  },
  "step": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "run"
    ],
    "properties": {
     "name": {
      "type": "string",
      "pattern": "\\S"
     },
     "run": {
      "type": "string",
      "pattern": "\\S"
     },
     "timeout": {
      "oneOf": [
       {
        "type": "integer",
        "minimum": 1,
        "maximum": 600
       },
       {
        "type": "string",
        "pattern": "^(?:[1-9]\\d?|[1-5]\\d{2}|600)s$"
       }
      ]
     },
     "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "tx"
      ],
      "properties": {
       "tx": {
        "enum": [
         "committed",
         "rejected"
        ]
       },
       "error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "code": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
         },
         "group": {
          "$ref": "https://spark-verify.invalid/schemas/ckb-verify-claims-v4.schema.json#/$defs/manifestErrorGroup"
         }
        }
       },
       "cycles": {
        "$ref": "https://spark-verify.invalid/schemas/ckb-verify-claims-v4.schema.json#/$defs/cyclesCheck"
       }
      },
      "allOf": [
       {
        "if": {
         "required": [
          "error"
         ],
         "type": "object",
         "properties": {
          "error": {}
         }
        },
        "then": {
         "properties": {
          "tx": {
           "const": "rejected"
          }
         },
         "type": "object"
        }
       }
      ]
     },
     "assert": {
      "$ref": "https://spark-verify.invalid/schemas/ckb-verify-claims-v4.schema.json#/$defs/manifestAssertions"
     }
    }
   }
  },
  "assert": {
   "$ref": "https://spark-verify.invalid/schemas/ckb-verify-claims-v4.schema.json#/$defs/manifestAssertions"
  }
 }
}
