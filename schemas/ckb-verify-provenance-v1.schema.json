{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Akane-CN/spark-verify/schemas/ckb-verify-provenance-v1.schema.json",
  "title": "CKB Verify Provenance v1",
  "description": "Structural validation for the replay qualification and source, runtime, lockfile, and binary provenance emitted by ckb-verify. Cross-field replay semantics are enforced by the ckb-verify semantic verifier.",
  "$comment": "JSON Schema Draft 2020-12 cannot portably compare arbitrary sibling values. Consumers must also run assertProvenanceConsistency, as verifyEvidenceDigests does, before trusting replay.status or reasons.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "replay", "source", "manifest", "lockfile", "runtime", "binaries"],
  "properties": {
    "schema": { "const": "ckb-verify-provenance/1" },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaredDependencies", "status", "reasons"],
      "properties": {
        "declaredDependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/replayDependency" }
        },
        "status": { "enum": ["stable", "tainted"] },
        "reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/reason" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "stable" } }, "required": ["status"] },
          "then": {
            "properties": {
              "declaredDependencies": { "type": "array", "maxItems": 0 },
              "reasons": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "tainted" } }, "required": ["status"] },
          "then": { "properties": { "reasons": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitCommit", "dirty", "dirtyDigest"],
      "properties": {
        "gitCommit": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        },
        "dirty": { "type": ["boolean", "null"] },
        "dirtyDigest": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "dirty": { "enum": [false, null] } },
            "required": ["dirty"]
          },
          "then": { "properties": { "dirtyDigest": { "type": "null" } } }
        }
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "lockfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "bun.lock" },
        "sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "requestedVersion", "observedVersion", "metadata"],
      "properties": {
        "name": { "const": "bun" },
        "requestedVersion": {
          "oneOf": [
            { "$ref": "#/$defs/version" },
            { "type": "null" }
          ]
        },
        "observedVersion": { "$ref": "#/$defs/version" },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "const": "package.json" },
            "sha256": {
              "oneOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "binaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ckb"],
      "properties": { "ckb": { "$ref": "#/$defs/ckbBinary" } }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "replay": {
            "type": "object",
            "properties": { "status": { "const": "stable" } },
            "required": ["status"]
          }
        },
        "required": ["replay"]
      },
      "then": {
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "dirty": { "const": false },
              "dirtyDigest": { "type": "null" }
            }
          },
          "lockfile": {
            "type": "object",
            "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
          },
          "runtime": {
            "type": "object",
            "properties": {
              "requestedVersion": { "$ref": "#/$defs/version" },
              "metadata": {
                "type": "object",
                "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "replayDependency": {
      "enum": ["external_time", "randomness", "fee_estimation", "dynamic_since", "external_network"]
    },
    "reason": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "code", "detail"],
          "properties": {
            "scope": { "const": "outcome" },
            "code": { "$ref": "#/$defs/replayDependency" },
            "detail": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "code", "detail"],
          "properties": {
            "scope": { "const": "environment" },
            "code": {
              "enum": [
                "dirty_source",
                "source_revision_unavailable",
                "source_state_unavailable",
                "runtime_pin_missing",
                "runtime_version_drift",
                "lockfile_missing"
              ]
            },
            "detail": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "ckbBinary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "platform",
        "architecture",
        "asset",
        "sourceUrl",
        "expectedArchiveSha256",
        "archiveSha256",
        "binarySha256"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "platform": { "enum": ["linux", "darwin", "win32"] },
        "architecture": { "enum": ["x64", "arm64"] },
        "asset": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "expectedArchiveSha256": { "$ref": "#/$defs/sha256" },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "binarySha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
