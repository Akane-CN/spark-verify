    },
    "block_number": {
     "type": "string",
     "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,15})$"
    },
    "tx_index": {
     "type": "string",
     "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,7})$"
    }
   }
  },
  "indexerPage": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "after_cursor",
    "response"
   ],
   "properties": {
    "after_cursor": {
     "oneOf": [
      {
       "type": "string",
       "pattern": "^0x[0-9a-f]*$"
