       "type": "boolean"
      },
      "ok": {
       "type": "boolean"
      },
      "input": {
       "$ref": "#/$defs/cellInput"
      }
     }
    },
    {
     "$ref": "#/$defs/cellDepsOutcome"
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "target",
      "expected",
      "observed",
      "observationValid",
      "ok",
      "input"
     ],
     "properties": {
      "kind": {
       "const": "balance"
      },
