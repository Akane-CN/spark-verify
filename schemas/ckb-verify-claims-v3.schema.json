    },
    "script_type": {
     "enum": [
      "lock",
      "type"
     ]
    },
    "script_search_mode": {
     "enum": [
      "exact",
      "prefix"
     ]
    },
    "filter": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "script"
     ],
     "properties": {
