     "properties": {
      "present": {
       "type": "array",
       "items": {
        "type": "boolean"
       }
      }
     }
    },
    "observationValid": {
     "const": true
    },
    "ok": {
     "type": "boolean"
    }
   }
  },
  "balanceOutcome": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "target",
