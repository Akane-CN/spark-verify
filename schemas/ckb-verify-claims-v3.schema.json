       "$ref": "#/$defs/rpcScript"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "rpcOutPoint": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "tx_hash",
    "index"
   ],
   "properties": {
    "tx_hash": {
     "$ref": "#/$defs/hash32"
    },
    "index": {
     "type": "string",
     "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,7})$"
    }
   }
  },
  "indexerSearchKey": {
   "type": "object",
   "additionalProperties": false,
