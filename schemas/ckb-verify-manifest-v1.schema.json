{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/Akane-CN/spark-verify/schemas/ckb-verify-manifest-v1.schema.json",
 "title": "CKB Verify manifest (parsed verify.toml)",
 "description": "Structural validation of a parsed verify.toml for manifest specs 0.1.0-draft.3, 0.1.0-draft.4, and 0.1.0-draft.5, mirroring the strict parser in src/manifest.ts: unknown keys are rejected everywhere. The parser additionally enforces rules a JSON Schema cannot express portably: out_point.step and cell_deps.step must name this or an earlier step, step names must be unique, at least one expectation or assertion must exist, a rejected expectation requires toolchain.ckb-debugger, and draft.4 manifests must be valid UTF-8 that round-trips byte for byte.",
 "$comment": "Dotted TOML keys and explicit tables normalize to the same parsed object before validation. Numeric bounds are runner policy, not consensus.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "meta",
  "toolchain",
  "replay",
  "setup",
  "step"
 ],
 "properties": {
  "meta": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "spec"
   ],
   "properties": {
    "name": {
     "type": "string",
     "pattern": "\\S",
     "maxLength": 100
    },
    "spec": {
     "enum": [
      "0.1.0-draft.3",
      "0.1.0-draft.4",
      "0.1.0-draft.5"
     ]
    },
    "description": {
     "type": "string",
     "pattern": "\\S"
    }
   }
  },
  "toolchain": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "ckb",
    "offckb"
   ],
   "properties": {
    "ckb": {
     "type": "string",
     "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "offckb": {
     "const": "0.4.13"
    },
    "ckb-debugger": {
     "const": "1.1.1",
     "$comment": "the only pinned debugger artifact (Linux x64)"
    }
   }
  },
  "replay": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "dependencies"
   ],
   "properties": {
    "dependencies": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "enum": [
       "external_time",
       "randomness",
       "fee_estimation",
       "dynamic_since",
       "external_network"
      ]
     }
    }
   }
  },
  "setup": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "accounts"
   ],
   "properties": {
    "accounts": {
     "type": "integer",
     "minimum": 1,
     "maximum": 20
    }
   }
  },
  "step": {
   "type": "array",
   "minItems": 1
  },
  "assert": true
 },
 "allOf": [
  {
   "if": {
    "type": "object",
    "properties": {
     "meta": {
      "type": "object",
      "properties": {
       "spec": {
        "const": "0.1.0-draft.4"
       }
      },
      "required": [
       "spec"
      ]
     }
    },
    "required": [
     "meta"
    ]
   },
   "then": {
    "properties": {
     "step": {
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "name",
        "run"
       ],
       "properties": {
        "name": {
         "type": "string",
         "pattern": "\\S"
        },
        "run": {
         "type": "string",
         "pattern": "\\S"
        },
        "timeout": {
         "oneOf": [
          {
           "type": "integer",
           "minimum": 1,
           "maximum": 600
          },
          {
           "type": "string",
           "pattern": "^(?:[1-9]\\d?|[1-5]\\d{2}|600)s$"
          }
         ]
        },
        "expect": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "tx"
         ],
         "properties": {
          "tx": {
           "enum": [
            "committed",
            "rejected"
           ]
          },
          "error": {
           "type": "object",
           "additionalProperties": false,
           "properties": {
            "code": {
             "type": "integer",
             "minimum": -9007199254740991,
             "maximum": 9007199254740991
            }
           }
          }
         },
         "allOf": [
          {
           "if": {
            "required": [
             "error"
            ],
            "type": "object",
            "properties": {
             "error": {}
            }
           },
           "then": {
            "properties": {
             "tx": {
              "const": "rejected"
             }
            },
            "type": "object"
           }
          }
         ]
        },
        "assert": {
         "$ref": "https://spark-verify.invalid/schemas/ckb-verify-claims-v2.schema.json#/$defs/manifestAssertions"
        }
       }
      },
      "type": "array"
     },
     "assert": {
      "$ref": "https://spark-verify.invalid/schemas/ckb-verify-claims-v2.schema.json#/$defs/manifestAssertions"
     }
    },
    "type": "object"
   }
  },
  {
   "if": {
    "type": "object",
    "properties": {
     "meta": {
      "type": "object",
      "properties": {
       "spec": {
        "const": "0.1.0-draft.5"
       }
      },
      "required": [
       "spec"
      ]
     }
    },
    "required": [
     "meta"
    ]
   },
   "then": {
    "properties": {
     "step": {
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "name",
        "run"
       ],
       "properties": {
        "name": {
         "type": "string",
         "pattern": "\\S"
        },
        "run": {
         "type": "string",
         "pattern": "\\S"
        },
        "timeout": {
         "oneOf": [
          {
           "type": "integer",
           "minimum": 1,
           "maximum": 600
          },
          {
           "type": "string",
           "pattern": "^(?:[1-9]\\d?|[1-5]\\d{2}|600)s$"
          }
         ]
        },
        "expect": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "tx"
         ],
         "properties": {
          "tx": {
           "enum": [
            "committed",
            "rejected"
           ]
          },
          "error": {
           "type": "object",
           "additionalProperties": false,
           "properties": {
            "code": {
             "type": "integer",
             "minimum": -9007199254740991,
             "maximum": 9007199254740991
            }
           }
          },
          "cycles": {
           "$ref": "https://spark-verify.invalid/schemas/ckb-verify-claims-v3.schema.json#/$defs/cyclesCheck"
          }
         },
         "allOf": [
          {
           "if": {
            "required": [
             "error"
            ],
            "type": "object",
            "properties": {
             "error": {}
            }
           },
           "then": {
            "properties": {
             "tx": {
              "const": "rejected"
             }
            },
            "type": "object"
           }
          }
         ]
        },
        "assert": {
         "$ref": "https://spark-verify.invalid/schemas/ckb-verify-claims-v3.schema.json#/$defs/manifestAssertions"
        }
       }
      },
      "type": "array"
     },
     "assert": {
      "$ref": "https://spark-verify.invalid/schemas/ckb-verify-claims-v3.schema.json#/$defs/manifestAssertions"
     }
    },
    "type": "object"
   }
  },
  {
   "if": {
    "type": "object",
    "properties": {
     "meta": {
      "type": "object",
      "properties": {
       "spec": {
        "const": "0.1.0-draft.3"
       }
      },
      "required": [
       "spec"
      ]
     }
    },
    "required": [
     "meta"
    ]
   },
   "then": {
    "properties": {
     "step": {
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "name",
        "run"
       ],
       "properties": {
        "name": {
         "type": "string",
         "pattern": "\\S"
        },
        "run": {
         "type": "string",
         "pattern": "\\S"
        },
        "timeout": {
         "oneOf": [
          {
           "type": "integer",
           "minimum": 1,
           "maximum": 600
          },
          {
           "type": "string",
           "pattern": "^(?:[1-9]\\d?|[1-5]\\d{2}|600)s$"
          }
         ]
        },
        "expect": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "tx"
         ],
         "properties": {
          "tx": {
           "enum": [
            "committed",
            "rejected"
           ]
          },
          "error": {
           "type": "object",
           "additionalProperties": false,
           "properties": {
            "code": {
             "type": "integer",
             "minimum": -9007199254740991,
             "maximum": 9007199254740991
            }
           }
          }
         },
         "allOf": [
          {
           "if": {
            "required": [
             "error"
            ],
            "type": "object",
            "properties": {
             "error": {}
            }
           },
           "then": {
            "properties": {
             "tx": {
              "const": "rejected"
             }
            },
            "type": "object"
           }
          }
         ]
        },
        "assert": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "cell": {
           "type": "array",
           "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "out_point",
             "count"
            ],
            "properties": {
             "out_point": {
              "type": "object",
              "additionalProperties": false,
              "required": [
               "step",
               "index"
              ],
              "properties": {
               "step": {
                "type": "string",
                "pattern": "\\S"
               },
               "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
               }
              }
             },
             "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
             }
            }
           }
          }
         }
        }
       }
      },
      "type": "array"
     },
     "assert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "cell": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "out_point",
          "count"
         ],
         "properties": {
          "out_point": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "step",
            "index"
           ],
           "properties": {
            "step": {
             "type": "string",
             "pattern": "\\S"
            },
            "index": {
             "type": "integer",
             "minimum": 0,
             "maximum": 9007199254740991
            }
           }
          },
          "count": {
           "type": "integer",
           "minimum": 0,
           "maximum": 9007199254740991
          }
         }
        }
       }
      }
     }
    },
    "type": "object"
   }
  }
 ]
}
