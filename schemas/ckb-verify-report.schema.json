{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/Akane-CN/spark-verify/schemas/ckb-verify-report.schema.json",
 "title": "CKB Verify evidence report (complete artifact)",
 "description": "Structural validation of a complete report.json: ckb-verify-report/1 (manifest spec 0.1.0-draft.3) and ckb-verify-report/2 (0.1.0-draft.4). Historical report/1 artifacts with environment/2 + provenance/1 validate structurally but are accepted by the verifier only with --allow-legacy. Shape validation never replaces the semantic verifier, which re-derives claims, verdict and both digests.",
 "$comment": "Unknown fields are rejected at every level except claim.evidence (retained RPC diagnostics). Digest, hash and cross-field agreement are semantic checks. The discriminator keyword is an OpenAPI extension Ajv understands; validators without it fall back to plain oneOf.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "verdict",
  "createdAt",
  "evidence",
  "outcomeClaims",
  "environment",
  "digests"
 ],
 "properties": {
  "schema": {
   "enum": [
    "ckb-verify-report/1",
    "ckb-verify-report/2",
    "ckb-verify-report/3"
   ]
  },
  "verdict": {
   "enum": [
    "PASS",
    "FAIL"
   ]
  },
  "createdAt": {
   "type": "string",
   "minLength": 1,
   "$comment": "display/provenance metadata excluded from both digests; the runner writes an ISO-8601 UTC timestamp, synthetic fixtures label themselves"
  },
  "evidence": true,
  "outcomeClaims": true,
  "environment": true,
  "digests": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "outcome",
    "environment"
   ],
   "properties": {
    "outcome": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "environment": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    }
   }
  }
 },
